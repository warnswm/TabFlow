    "@fontsource/onest": "^5.3.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.6",
    "lucide-react": "^1.58.0",
    "minisearch": "^7.2.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
