{
  "name": "tabflow",
  "description": "TabFlow — менеджер вкладок для Chrome. Всё на виду. Ничего в памяти.",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
